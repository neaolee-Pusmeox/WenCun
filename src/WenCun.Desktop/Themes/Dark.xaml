<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 夜色不是蓝黑：保留一点纸与墨的温度。 -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#141714"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C211D"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#141714"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#242A25"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#1F2520"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EAE5DA"/>
    <SolidColorBrush x:Key="HeadingBrush" Color="#F2EEE5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A3A79C"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#959B90"/>
    <!-- 交互轮廓独立于面板边框，兼顾纸面、悬停和选中底色。 -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#7D887B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#333A34"/>
    <SolidColorBrush x:Key="RuleBrush" Color="#2A302A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8FB7A2"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A6C9B5"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#24352C"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#B9D6C4"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#DDE7DC"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#EEF4ED"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#16211B"/>
    <SolidColorBrush x:Key="SealBrush" Color="#D97757"/>
    <SolidColorBrush x:Key="SealSoftBrush" Color="#3A2822"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E08A7A"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A2622"/>
    <SolidColorBrush x:Key="OkBrush" Color="#7FC3A2"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="#1F352A"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D6B06A"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#352C1C"/>
    <SolidColorBrush x:Key="NavActiveBrush" Color="#263029"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#1E241F"/>
    <SolidColorBrush x:Key="LogoGroundBrush" Color="#EDE6D8"/>
    <SolidColorBrush x:Key="LogoStrokeBrush" Color="#19352C"/>
    <SolidColorBrush x:Key="LogoDotBrush" Color="#C25A3D"/>
</ResourceDictionary>
