<Window x:Class="WenCun.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文存 — 公众号文章存档" Width="1280" Height="840" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/WenCun;component/Assets/wencun.ico"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="StatePillBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OkSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SealSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatePillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SealBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- 左侧：品牌与目录 -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Width="40" Height="40" Content="{StaticResource WenCunMark}"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="文存" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                               FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"/>
                        <TextBlock Text="公众号文章存档" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,26,0,0">
                    <TextBlock Text="目录" Style="{StaticResource Overline}" Margin="11,0,0,8"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                 IsChecked="{Binding Section, Converter={StaticResource Section}, ConverterParameter=Library, Mode=TwoWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="01" Style="{StaticResource NavIndex}"/>
                            <TextBlock Grid.Column="1" Text="资料库"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                 IsChecked="{Binding Section, Converter={StaticResource Section}, ConverterParameter=Collect, Mode=TwoWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="02" Style="{StaticResource NavIndex}"/>
                            <TextBlock Grid.Column="1" Text="采集"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                 IsChecked="{Binding Section, Converter={StaticResource Section}, ConverterParameter=Accounts, Mode=TwoWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="03" Style="{StaticResource NavIndex}"/>
                            <TextBlock Grid.Column="1" Text="公众号"/>
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Style="{StaticResource Divider}" Margin="4,0,4,12"/>
                    <TextBlock Text="当前文库" Style="{StaticResource Overline}" Margin="7,0,0,5"/>
                    <TextBlock Text="{Binding LibraryPath}" Style="{StaticResource Mono}"
                               Margin="7,0,0,8" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding LibraryPath}"/>
                    <Button Content="打开文库文件夹" Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource SidebarAction}"/>
                    <Button Content="切换明暗外观" Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource SidebarAction}"/>
                    <TextBlock Text="字体 HarmonyOS Sans" Style="{StaticResource Caption}"
                               FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               Margin="7,10,0,0"
                               ToolTip="内置 HarmonyOS Sans SC，遵循 HarmonyOS Sans Fonts License Agreement"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主工作区 -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="34,28,34,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding SectionSubtitle}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- 资料库 -->
                <Grid Visibility="{Binding IsLibrarySection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Height="34">
                            <TextBox Text="{Binding LibraryPage.Search, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,6,36,6">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LibraryPage.SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="搜索标题、公众号、作者" Foreground="{DynamicResource FaintBrush}"
                                       FontSize="13" Margin="13,0,36,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LibraryPage.Search}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Command="{Binding LibraryPage.SearchCommand}" Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                    ToolTip="搜索（Enter）">
                                <Grid Width="15" Height="15">
                                    <Ellipse Width="9" Height="9" Stroke="{DynamicResource MutedBrush}"
                                             StrokeThickness="1.3" HorizontalAlignment="Left"
                                             VerticalAlignment="Top" Margin="1,1,0,0"/>
                                    <Path Data="M8.6,8.6 L13.2,13.2" Stroke="{DynamicResource MutedBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                </Grid>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <RadioButton Content="全部" Style="{StaticResource FilterTab}" GroupName="State"
                                         IsChecked="{Binding LibraryPage.ShowAll, Mode=TwoWay}"/>
                            <RadioButton Content="待保存" Style="{StaticResource FilterTab}" GroupName="State"
                                         IsChecked="{Binding LibraryPage.ShowPending, Mode=TwoWay}"/>
                            <RadioButton Content="已保存" Style="{StaticResource FilterTab}" GroupName="State"
                                         IsChecked="{Binding LibraryPage.ShowReady, Mode=TwoWay}"/>
                            <RadioButton Content="失败" Style="{StaticResource FilterTab}" GroupName="State"
                                         IsChecked="{Binding LibraryPage.ShowFailed, Mode=TwoWay}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding LibraryPage.ToggleSortCommand}"
                                Style="{StaticResource ToolbarButton}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="排序" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding LibraryPage.SortText}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="16,10,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LibraryPage.Summary}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                            Visibility="{Binding LibraryPage.IsPendingView, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Button Content="刷新" Command="{Binding LibraryPage.RefreshCommand}"
                                            Style="{StaticResource ToolbarButton}"/>
                                    <Button Content="重试失败" Command="{Binding LibraryPage.RetryFailedCommand}"
                                            Style="{StaticResource ToolbarButton}" Margin="2,0,0,0"/>
                                    <Button Content="重新导出" Command="{Binding LibraryPage.ReexportSelectedCommand}"
                                            Style="{StaticResource ToolbarButton}" Margin="2,0,0,0"/>
                                    <Button Content="删除" Command="{Binding LibraryPage.DeleteCommand}"
                                            Style="{StaticResource DangerTextButton}" Margin="2,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                            Visibility="{Binding LibraryPage.IsPendingView, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="刷新" Command="{Binding LibraryPage.RefreshCommand}"
                                            Style="{StaticResource ToolbarButton}"/>
                        <Button Content="保存所选" Command="{Binding LibraryPage.SaveSelectedPendingCommand}"
                                            Style="{StaticResource PrimaryButton}" FontSize="13"
                                            Padding="10,4" MinHeight="28" Margin="4,0,0,0"/>
                                    <Button Content="清理旧记录" Command="{Binding LibraryPage.CleanupLegacyCommand}"
                                            Style="{StaticResource ToolbarButton}" Margin="2,0,0,0"/>
                                    <Button Content="删除" Command="{Binding LibraryPage.DeleteCommand}"
                                            Style="{StaticResource DangerTextButton}" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" BorderBrush="{DynamicResource RuleBrush}"
                                    BorderThickness="0,0,0,1" Padding="16,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="144"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding LibraryPage.AllSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" ToolTip="全选"/>
                                    <TextBlock Grid.Column="1" Text="文章" Style="{StaticResource ColumnLabel}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="状态" Style="{StaticResource ColumnLabel}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource ColumnLabel}"
                                               HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="208"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,1,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="公众号" Style="{StaticResource ColumnLabel}"
                                                   Margin="16,12,16,6"/>
                                        <RadioButton Grid.Row="1" Style="{StaticResource ListChoice}"
                                                     GroupName="Accounts" Margin="8,0,8,2"
                                                     Content="{Binding LibraryPage.AllAccountsText}"
                                                     IsChecked="{Binding LibraryPage.IsAllAccounts, Mode=OneWay}"
                                                     Command="{Binding LibraryPage.SelectAllCommand}"/>
                                        <ListBox Grid.Row="2" ItemsSource="{Binding LibraryPage.Accounts}"
                                                 SelectedItem="{Binding LibraryPage.SelectedAccount, Mode=TwoWay}"
                                                 Margin="8,0,8,8" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Counts}" Style="{StaticResource Caption}"
                                                                   FontSize="12" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding LibraryPage.Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource RuleBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid Margin="16,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="96"/>
                                                                <ColumnDefinition Width="144"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                                                      VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                            <StackPanel Grid.Column="1" Margin="6,0,12,0">
                                                                <TextBlock Text="{Binding Title}" FontSize="15"
                                                                           FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           ToolTip="{Binding Title}"/>
                                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}"
                                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Meta}"/>
                                                                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}"
                                                                           FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                                                                <TextBlock Text="{Binding ExportErrorText}" Foreground="{DynamicResource WarnBrush}"
                                                                           FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                           Visibility="{Binding HasExportError, Converter={StaticResource BoolToVisibility}}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Border Style="{StaticResource StatePillBorder}">
                                                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource StatePillText}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding ExportText}" Style="{StaticResource Caption}"
                                                                           FontSize="12" HorizontalAlignment="Center"
                                                                           Margin="0,4,0,0"
                                                                           Visibility="{Binding HasExport, Converter={StaticResource BoolToVisibility}}"/>
                                                            </StackPanel>
                                                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0" Content="阅读" Style="{StaticResource RowAction}"
                                                                        Command="{Binding DataContext.LibraryPage.ReadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding IsNormal, Converter={StaticResource BoolToVisibility}}"/>
                                                                <Button Grid.Column="1" Content="重试" Style="{StaticResource RowAction}"
                                                                        Command="{Binding DataContext.LibraryPage.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}"/>
                                                                <Button Grid.Column="2" Content="文件夹" Style="{StaticResource RowAction}" Margin="2,0,0,0"
                                                                        Command="{Binding DataContext.LibraryPage.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding IsNormal, Converter={StaticResource BoolToVisibility}}"/>
                                                                <Button Grid.Column="0" Content="保存" Style="{StaticResource RowAction}" Margin="2,0,0,0"
                                                                        Foreground="{DynamicResource AccentTextBrush}" FontWeight="Medium"
                                                                        Command="{Binding DataContext.LibraryPage.SavePendingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding LibraryPage.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding LibraryPage.EmptyText}" Style="{StaticResource Muted}"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Button Content="获取目录" Command="{Binding GoToCollectCommand}"
                                                Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="2,10,2,0"
                          Visibility="{Binding LibraryPage.IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding LibraryPage.PageText}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="上一页" Command="{Binding LibraryPage.PrevCommand}"
                                    Style="{StaticResource ToolbarButton}"/>
                            <Button Content="下一页" Command="{Binding LibraryPage.NextCommand}"
                                    Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 采集 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsCollectSection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Style="{StaticResource Panel}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="获取公众号目录" Style="{StaticResource H2}"/>
                                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding CollectPage.Consent, Mode=TwoWay}">
                                        <TextBlock Text="同意安装本地证书，并在获取目录时临时设置系统代理"
                                                   TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="22,4,0,0"
                                               Text="仅在连接微信时使用，结束后自动恢复网络设置。"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="获取目录" Command="{Binding CollectPage.StartCommand}"
                                                Style="{StaticResource PrimaryButton}" MinWidth="112"/>
                                        <Button Content="停止" Command="{Binding CollectPage.StopCommand}"
                                                Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                                IsEnabled="{Binding CollectPage.IsBusy}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding CollectPage.State}" FontSize="15"
                                               FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CollectPage.Detail}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <ProgressBar IsIndeterminate="{Binding CollectPage.IsBusy}" Margin="0,14,0,0"
                                                 Visibility="{Binding CollectPage.IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                                    <Grid Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="已读取目录页" Style="{StaticResource StatLabel}"/>
                                            <TextBlock Text="{Binding CollectPage.PageCount}" Style="{StaticResource StatValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="待保存文章" Style="{StaticResource StatLabel}"/>
                                            <TextBlock Text="{Binding CollectPage.PendingCount}" Style="{StaticResource StatValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Height="388" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Panel}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Margin="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="选择文章" Style="{StaticResource H2}"/>
                                            <TextBlock Text="{Binding PendingPage.Summary}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="删除" Command="{Binding PendingPage.DeleteCommand}"
                                                    Style="{StaticResource DangerTextButton}"/>
                                            <Button Content="{Binding PendingPage.SaveText}" Command="{Binding PendingPage.SaveCommand}"
                                                    Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="144"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <RadioButton Content="全部公众号"
                                                             Style="{StaticResource ListChoice}"
                                                             GroupName="PendingAccounts" Margin="8,8,8,2"
                                                             IsChecked="{Binding PendingPage.IsAllAccounts, Mode=OneWay}"
                                                             Command="{Binding PendingPage.SelectAllCommand}"/>
                                                <ListBox Grid.Row="1" ItemsSource="{Binding PendingPage.Accounts}"
                                                         SelectedItem="{Binding PendingPage.SelectedAccount, Mode=TwoWay}"
                                                         Margin="8,0,8,8">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                                           FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Name}"/>
                                                                <TextBlock Text="{Binding Counts}" Style="{StaticResource Caption}"
                                                                           FontSize="12" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border BorderBrush="{DynamicResource RuleBrush}"
                                                    BorderThickness="0,1,0,1" Padding="12,7">
                                                <CheckBox Content="全选" IsChecked="{Binding PendingPage.AllSelected, Mode=TwoWay}"/>
                                            </Border>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding PendingPage.Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource RuleBrush}"
                                                                    BorderThickness="0,0,0,1" Padding="12,10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="24"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                                                              VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                                        <TextBlock Text="{Binding Title}" FontSize="15"
                                                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   ToolTip="{Binding Title}"/>
                                                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}"
                                                                                   FontSize="12" Margin="0,3,0,0"/>
                                                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                                                                                   FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock Grid.Row="1" Text="{Binding PendingPage.EmptyText}"
                                                       Style="{StaticResource Muted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="24,0"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding PendingPage.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="18" Margin="16,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="保存设置" Style="{StaticResource H2}"/>

                                    <TextBlock Text="文件格式" Style="{StaticResource FieldLabel}" Margin="0,18,0,8"/>
                                    <WrapPanel>
                                        <CheckBox Content="HTML" Style="{StaticResource FormatChip}"
                                                  ToolTip="网页文件，可用浏览器打开"
                                                  IsChecked="{Binding CollectPage.SaveHtml, Mode=TwoWay}"/>
                                        <CheckBox Content="Markdown" Style="{StaticResource FormatChip}"
                                                  IsChecked="{Binding CollectPage.SaveMarkdown, Mode=TwoWay}"/>
                                        <CheckBox Content="TXT" Style="{StaticResource FormatChip}"
                                                  ToolTip="纯文本"
                                                  IsChecked="{Binding CollectPage.SaveText, Mode=TwoWay}"/>
                                        <CheckBox Content="Word" Style="{StaticResource FormatChip}"
                                                  IsChecked="{Binding CollectPage.SaveWord, Mode=TwoWay}"/>
                                        <CheckBox Content="PDF" Style="{StaticResource FormatChip}"
                                                  IsChecked="{Binding CollectPage.SavePdf, Mode=TwoWay}"/>
                                    </WrapPanel>

                                    <TextBlock Text="文章图片" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
                                    <StackPanel>
                                        <RadioButton Content="保存到本地" GroupName="Images"
                                                     IsChecked="{Binding CollectPage.ImagesDownload, Mode=TwoWay}"
                                                     Margin="0,0,0,7"/>
                                        <RadioButton Content="使用在线图片" GroupName="Images"
                                                     IsChecked="{Binding CollectPage.ImagesLink, Mode=TwoWay}"
                                                     Margin="0,0,0,7"/>
                                        <RadioButton Content="不保存图片" GroupName="Images"
                                                     IsChecked="{Binding CollectPage.ImagesNone, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0"
                                            Margin="0,18,0,0" Padding="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="保存位置" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{Binding CollectPage.LibraryPath}" Style="{StaticResource Mono}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                                       ToolTip="{Binding CollectPage.LibraryPath}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="更换位置" Command="{Binding CollectPage.ChangeLibraryCommand}"
                                                        Style="{StaticResource ToolbarButton}"
                                                        ToolTip="可打开已有文库，或选择空文件夹复制当前文库"
                                                        IsEnabled="{Binding CollectPage.CanEditSettings}"/>
                                                <Button Content="证书管理" Command="{Binding CollectPage.ToggleCertificateCommand}"
                                                        Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,12,0,0" Visibility="{Binding CollectPage.ShowCertificate, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="用于读取微信文章目录，只保存在当前 Windows 用户下。"
                                                           Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                <Button Content="移除本地证书" Command="{Binding CollectPage.RemoveCertificateCommand}"
                                                        Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 公众号 -->
                <Grid Visibility="{Binding IsAccountsSection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Panel}" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="18,10">
                                <TextBlock Text="公众号" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding AccountsPage.AccountCount}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource RuleBrush}"
                                    BorderThickness="1,0,0,0" Padding="18,10">
                                <StackPanel>
                                    <TextBlock Text="已保存文章" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding AccountsPage.SavedTotal}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource RuleBrush}"
                                    BorderThickness="1,0,0,0" Padding="18,10">
                                <StackPanel>
                                    <TextBlock Text="保存失败" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding AccountsPage.FailedTotal}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="{DynamicResource RuleBrush}"
                                    BorderThickness="1,0,0,0" Padding="18,10">
                                <StackPanel>
                                    <TextBlock Text="待保存文章" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding AccountsPage.PendingTotal}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="4" Content="刷新" Command="{Binding AccountsPage.RefreshCommand}"
                                    Style="{StaticResource ToolbarButton}" Margin="12,0,16,0"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Padding="16,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="公众号" Style="{StaticResource ColumnLabel}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="操作" Style="{StaticResource ColumnLabel}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding AccountsPage.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource RuleBrush}"
                                                        BorderThickness="0,0,0,1" Padding="16,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="32" Height="32" CornerRadius="8"
                                                                Background="{DynamicResource SubtleBrush}"
                                                                BorderBrush="{DynamicResource RuleBrush}"
                                                                BorderThickness="1" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Initial}"
                                                                       FontFamily="{StaticResource DisplayFont}"
                                                                       FontSize="15" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource HeadingBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="15"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Name}"/>
                                                            <TextBlock Text="{Binding ShortStats}" Style="{StaticResource Caption}"
                                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Stats}"/>
                                                            <TextBlock Style="{StaticResource Caption}" FontSize="12"
                                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding LatestText, Mode=OneWay}"/><Run Text="，"/><Run Text="{Binding CollectedText, Mode=OneWay}"/><Run Text="，"/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <WrapPanel Grid.Column="2" Orientation="Horizontal"
                                                                   VerticalAlignment="Center" MaxWidth="480">
                                                            <Button Content="查看文章" Style="{StaticResource ToolbarButton}"
                                                                    Command="{Binding DataContext.AccountsPage.ViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="待保存" Style="{StaticResource ToolbarButton}"
                                                                    Margin="2,0,0,0"
                                                                    Command="{Binding DataContext.AccountsPage.ViewPendingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}"/>
                                                            <Button Content="获取目录" Style="{StaticResource ToolbarButton}"
                                                                    Margin="2,0,0,0"
                                                                    Command="{Binding DataContext.AccountsPage.CollectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="重试" Style="{StaticResource ToolbarButton}"
                                                                    Margin="2,0,0,0"
                                                                    Command="{Binding DataContext.AccountsPage.RetryFailedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}"/>
                                                            <Button Content="重新导出" Style="{StaticResource ToolbarButton}"
                                                                    Margin="2,0,0,0"
                                                                    Command="{Binding DataContext.AccountsPage.ReexportFailedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding HasExportFailed, Converter={StaticResource BoolToVisibility}}"/>
                                                            <Button Content="删除" Style="{StaticResource DangerTextButton}"
                                                                    Margin="2,0,0,0"
                                                                    ToolTip="同时删除文章、图片、导出文件和待保存清单，无法撤销"
                                                                    Command="{Binding DataContext.AccountsPage.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </WrapPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding AccountsPage.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="获取目录后，这里会显示公众号和保存进度"
                                               Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                    <Button Content="获取目录" Command="{Binding GoToCollectCommand}"
                                            Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="34,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Caption}"
                               FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Status}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding BuildText}" Style="{StaticResource Caption}"
                           FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
